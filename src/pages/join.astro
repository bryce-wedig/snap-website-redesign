---
import PageLayout from '../layouts/PageLayout.astro';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { join } from 'path';

const siteData = parse(readFileSync(join(process.cwd(), 'src/data/site.yaml'), 'utf-8'));
---

<PageLayout
  title="Get Involved"
  eyebrow="Join us"
  lede="Whether you're part of an established science policy group or an individual advocate, you're welcome here."
  variant="dark"
>
  <div class="join-actions">
    <div class="join-card">
      <div class="join-icon"><i class="fa-solid fa-clipboard-list"></i></div>
      <div class="join-tag"><span class="dot"></span>Step one</div>
      <h3>Complete the Interest Form</h3>
      <p>Join our mailing list and stay updated through our newsletter.</p>
      <a href={siteData.interest_form_url} target="_blank" rel="noopener" class="btn btn-primary">
        Interest Form <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>
    </div>

    <div class="join-card">
      <div class="join-icon"><i class="fa-brands fa-slack"></i></div>
      <div class="join-tag"><span class="dot"></span>Step two</div>
      <h3>Join Our Slack</h3>
      <p>Connect with fellow advocates, organize initiatives, and access shared resources.</p>
      <p class="join-note">Indicate your interest via the Interest Form to receive an invite.</p>
    </div>

    <div class="join-card">
      <div class="join-icon"><i class="fa-solid fa-envelope"></i></div>
      <div class="join-tag"><span class="dot"></span>Any time</div>
      <h3>Contact Us</h3>
      <p>Have questions? Reach out to us directly.</p>
      <a href={`mailto:${siteData.email}`} class="btn btn-ghost-dark">
        <i class="fa-solid fa-envelope"></i> Send Email
      </a>
    </div>
  </div>
</PageLayout>

<style>
  .join-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }

  /* Card anatomy follows .init-card: hairline border, accent bar on hover, lift. */
  .join-card {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: flex-start; gap: 12px;
    background: white;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: 32px 32px 28px;
    transition: all .2s ease;
  }
  .join-card::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 4px; background: var(--orange);
    transform: scaleY(0.3); transform-origin: top;
    transition: transform .3s ease;
  }
  .join-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
    border-color: var(--orange);
  }
  .join-card:hover::before { transform: scaleY(1); }

  .join-icon {
    width: 3rem; height: 3rem;
    border-radius: var(--r-pill);
    background: var(--peach-tint);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.25rem;
    color: var(--orange);
  }

  .join-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--accent); font-weight: 700; font-size: 10px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--orange);
  }
  .join-tag .dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--orange);
  }

  .join-card h3 {
    font-family: var(--display); font-weight: 700; font-size: 24px;
    color: var(--navy); letter-spacing: -0.015em; line-height: 1.2;
    margin: 0;
  }

  .join-card p {
    font-size: 15.5px; line-height: 1.6; color: var(--body); margin: 0;
  }
  .join-card .join-note {
    font-family: var(--accent); font-weight: 500; font-size: 13px;
    color: var(--muted);
  }

  .join-card .btn { margin-top: 6px; }
</style>
