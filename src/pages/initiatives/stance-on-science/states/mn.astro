---
import StanceStatePage from '../../../../components/stance/StanceStatePage.astro';

const base = import.meta.env.BASE_URL;
const additionalNoteHtml = `Senator Amy Klobuchar, running for Governor, provided <a href="${base}files/stance/klobuchar_letter.pdf">this letter</a> to the Minnesota Stance on Science team.`;
---

<StanceStatePage state="mn" additionalNoteHtml={additionalNoteHtml}>
  <p>This webpage houses the responses to 6 questions
    crafted by the Minnesota Stance on Science team.</p>
    <p>Only official candidates who will appear on ballots were contacted.</p>
    <p>Candidates were contacted in July 2026 (with a follow-up to those who
    did not initially respond) and given the opportunity to answer all questions. Only the responses of candidates who answered the questions are
    included. None of the candidates' responses were modified in any way before
    being published on this resource page.</p>

    <p><u>For the <strong>August 2026 Primary Election</strong></u>, only candidates in
    the following elections were contacted<sup>1</sup>:</p>

    <div>
      <div class="stance-race-flat">Minnesota Governor</div>
      <div class="stance-race-flat">U.S. Senator (MN)</div>
      <div class="stance-race-flat">U.S. House of Representatives (MN)</div>
      <details class="stance-race-group">
        <summary>Minnesota State Senator</summary>
          <ul>
            <li>Republican Party Primary for Districts 5, 10, 13, 19, 20, and 56</li>
            <li>Democratic Party Primary for Districts 19, 23, 29, 37, 38, 44, 46, 50, 62, and 65</li>
          </ul>
      </details>
      <details class="stance-race-group">
        <summary>Minnesota State House of Representatives</summary>
          <ul>
            <li>Republican Party Primary for Districts 6B, 9B, 10A, 14A, 17A, 20B, 38A, and 54B</li>
            <li>Democratic Party Primary for Districts 4A, 14A, 15B, 20B, 23A, 29B, 38A, 39B, 40A, 55B, 60B, and 65B</li>
          </ul>
      </details>
    </div>
    <p><small><sup>1</sup> These primary elections were prioritized because
    they have more than one official candidate on the ballot.</small></p>

    <p>Prior to the <u>general election in November 2026</u>,
    additional candidates will be contacted across all state districts. For a
    complete list of which elections will be targeted at that time, please
    check back in Fall 2026.</p>
</StanceStatePage>
