---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allInitiatives = await getCollection('initiatives');

const categories = [
  { key: 'current', title: 'Active initiatives', tag: 'Live' },
  { key: 'upcoming', title: 'Upcoming', tag: 'Soon' },
  { key: 'past', title: 'Past work', tag: 'Archive' },
] as const;

// Map common initiative slugs to color modifiers from the design system.
const colorFor: Record<string, string> = {
  'mcclintock-letters': 'c-mcclintock',
  'mcclintock-letters-open-letter': 'c-mcclintock',
  'mcclintock-letters-press-release': 'c-mcclintock',
  'congressional-visits': 'c-hillday',
  'scipol-hackathon': 'c-hackathon',
  'stance-on-science': 'c-stance',
  'scipol-courses': 'c-courses',
  'snapstart': 'c-snapstart',
};
---

<PageLayout
  title="Initiatives"
  eyebrow="What we're doing"
  lede="Standing programs that any chapter — or any member — can plug into. Each runs on its own cycle; most are open right now."
>
  {categories.map((cat) => {
    const items = allInitiatives
      .filter((i) => i.data.category === cat.key)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    if (items.length === 0) return null;

    return (
      <section style="margin-bottom: 64px;">
        <div class="cat-head">
          <h2>{cat.title}</h2>
          <span class="cat-count">{items.length} {items.length === 1 ? 'initiative' : 'initiatives'}</span>
        </div>

        <div class="init-grid-list">
          {items.map((item) => (
            <a class:list={['init-card', colorFor[item.id] || 'c-mcclintock']} href={`${base}initiatives/${item.id}/`}>
              <div class="row1">
                <div class="init-tag"><span class="dot"></span>{cat.tag}</div>
                <div class="init-status">{cat.key}</div>
              </div>
              <h4>{item.data.title}</h4>
              {item.data.excerpt && <p>{item.data.excerpt}</p>}
              <div class="foot">
                <div class="next"><span class="next-lbl">Updated</span>{item.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</div>
                <span class="arrow">Read more</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</PageLayout>

<style>
  .cat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 24px;
    border-bottom: 1px solid var(--hairline);
  }
  .cat-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 32px;
    color: var(--navy); letter-spacing: -0.02em; margin: 0;
  }
  .cat-count {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .init-grid-list {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
  }
  @media (max-width: 800px) {
    .init-grid-list { grid-template-columns: 1fr; }
  }
</style>
