---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const siteInterestForm = 'https://docs.google.com/forms/d/e/1FAIpQLSclm6qDeLHbwRk4QPuZR34x77xx5dlKz3tHuHitBdWAiWe5vg/viewform';

const newsletters = (await getCollection('newsletters')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(d: Date): string {
  // Frontmatter dates parse as UTC midnight; format in UTC so the day doesn't
  // shift backwards when the site is built in a western timezone.
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<PageLayout
  title="Newsletters"
  eyebrow="Stay in the loop"
  lede="One newsletter, once a month."
>
  <a slot="head-cta" class="btn btn-primary" href={siteInterestForm} target="_blank" rel="noopener">Sign up →</a>

  <section class="nl-section">
    <div class="cat-head">
      <h2>Archive</h2>
      <span class="cat-count">{newsletters.length} {newsletters.length === 1 ? 'issue' : 'issues'}</span>
    </div>
    <ul class="press-list nl-list">
      {newsletters.map(nl => (
        <li>
          <a class="head" href={`${base}newsletters/${nl.id}/`}>{nl.data.title}</a>
          <time>{formatDate(nl.data.date)}</time>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>

<style>
  .nl-section { margin-bottom: 0; }

  .cat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 0;
    border-bottom: 1px solid var(--hairline);
  }
  /* The head rule already closes the top of the ledger. */
  .nl-list li:first-child { border-top: none; }
  .cat-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 32px;
    color: var(--navy); letter-spacing: -0.02em; margin: 0;
  }
  .cat-count {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }

  /* Same ledger rows as the press page, minus the source column. */
  .nl-list li { grid-template-columns: 1fr 130px; }

  @media (max-width: 720px) {
    .nl-list li { grid-template-columns: 1fr; }
  }
</style>
