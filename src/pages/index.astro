---
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { join } from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import mcclintockPortrait from '../assets/images/initiatives/McClintock1947.png';

const base = import.meta.env.BASE_URL;
const pressData = parse(
  readFileSync(join(process.cwd(), 'src/data/press.yaml'), 'utf-8')
) as Array<{ date: string; headline: string; source: string; website: string }>;

const recentPress = pressData
  .filter((a) => a.headline && a.source && a.website)
  .slice(0, 5);

const letters = parse(
  readFileSync(join(process.cwd(), 'src/data/mcclintock_letters.yaml'), 'utf-8')
) as Array<{ headline?: string; website?: string; location?: string }>;
const placedLetters = letters.filter((l) => l.headline && l.website);
const letterStates = Array.from(new Set(placedLetters.map((l) => l.location).filter(Boolean)));

function formatDate(d: string): string {
  return new Date(d).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout title="Home">
  <Fragment slot="head">
    <!-- The hero map's basemap tiles are the LCP element; warm the connection
         while Leaflet is still being fetched and parsed. The {s} subdomain
         rotation resolves through the same connection pool. -->
    <link rel="preconnect" href="https://a.basemaps.cartocdn.com" crossorigin />
  </Fragment>
  <Header slot="header" />

  <!-- ============ ANNOUNCEMENT ============ -->
  <a class="announce-bar" href={`${base}initiatives/snapstart/`}>
    <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
    Check out the new <strong>&nbsp;SNAPStart&nbsp;</strong> Mini-Grant Program!
  </a>

  <!-- ============ HERO ============ -->
  <HomeHero />

  <!-- ============ INITIATIVES INTRO ============ -->
  <section id="initiatives">
    <div class="intro-strip">
      <div>
        {/* <div class="eyebrow"></div> */}
        <h2 class="display">Initiatives<br/><em>What we're doing now</em></h2>
      </div>
      <p class="lede">description of our initiatives and invitation to get involved</p>
    </div>

    <div class="initiatives">
      <!-- SPOTLIGHT -->
      <div class="init-spotlight">
        <article class="spotlight-card">
          <div class="spotlight-body">
            <div class="init-tag"><span class="live-dot"></span>Award-winning campaign</div>
            <h3>McClintock<br/>Letters</h3>
            <p>Improving communication between scientists and the public is crucial for rebuilding trust and addressing misinformation. We're inviting scientists to share their stories with their local hometown paper through the McClintock Letters Initiative — a national op-ed writing campaign. <span class="em">Recipient of the Research!America "Meeting the Moment for Public Health" Award.</span></p>

            <div class="spotlight-counts">
              <div><div class="num">{placedLetters.length}+</div><div class="lbl">Published</div></div>
              <div><div class="num">{letterStates.length}</div><div class="lbl">States</div></div>
              <div><div class="num">make dynamic</div><div class="lbl">Press Mentions</div></div>
            </div>

            <div class="spotlight-cta">
              <a class="btn btn-primary" href={`${base}initiatives/mcclintock-letters/`}>Submit a letter</a>
              <a class="btn btn-ghost-dark" href={`${base}initiatives/mcclintock-letters/`}>Read all letters →</a>
            </div>
          </div>
          <div class="spotlight-portrait">
            <Image class="portrait-img" src={mcclintockPortrait} alt="Barbara McClintock in her lab at Cold Spring Harbor, 1947" widths={[470, 917]} sizes="(max-width: 900px) 100vw, 470px" loading="lazy" />
            <div class="portrait-caption">
              <div class="who">Barbara McClintock, 1902–1992</div>
              <div class="desc">Nobel laureate, cytogeneticist — and a model of scientists writing for the public good.</div>
            </div>
          </div>
        </article>
      </div>

      <!-- 2x2 SECONDARY CARDS -->
      <div class="init-grid">
        <a class="init-card c-hillday" href={`${base}initiatives/congressional-visits/`}>
          <h4>Congressional District Visits</h4>
          <p>Early-career scientists meet with their Members of Congress at hometown district offices during the August recess, lowering barriers to participation and building local connections.</p>
          <div class="stats-row">
            <div><div class="num">54</div><div class="lbl">Visits</div></div>
            <div><div class="num">29</div><div class="lbl">States</div></div>
          </div>
          <div class="foot">
            <div class="next"><span class="next-lbl">Status</span>Follow-up surveys underway</div>
            <span class="arrow">Read more</span>
          </div>
        </a>

        <a class="init-card c-hackathon" href={`${base}initiatives/scipol-hackathon/`}>
          <h4>SciPol Hackathon</h4>
          <p>Interdisciplinary teams work over three days to create a science-policy technical product, a multimedia piece, or a written output.</p>
          <div class="stats-row">
            <div><div class="num">3-day</div><div class="lbl">Event</div></div>
            <div><div class="num">Summer</div><div class="lbl">Coming</div></div>
          </div>
          <div class="foot">
            <div class="next"><span class="next-lbl">Status</span>Planning underway</div>
            <span class="arrow">Learn more</span>
          </div>
        </a>

        <a class="init-card c-stance" href={`${base}initiatives/stance-on-science/`}>
          <h4>Stance on Science</h4>
          <p>A public, sourced tracker of where every candidate for office stands on the key science-policy questions of the moment. Updated as responses come in.</p>
          <div class="stats-row">
            <div><div class="num">2026</div><div class="lbl">Election cycle</div></div>
            <div><div class="num">State-led</div><div class="lbl">Teams</div></div>
          </div>
          <div class="foot">
            <div class="next"><span class="next-lbl">New this season</span>Candidate outreach launching</div>
            <span class="arrow">Open tracker</span>
          </div>
        </a>

        <a class="init-card c-courses" href={`${base}courses/`}>
          <h4>Courses</h4>
          <p>A modular science policy curriculum &mdash; what is science policy, how government works, writing for policy makers, and science communication. Free and open-access.</p>
          <div class="stats-row">
            <div><div class="num">multi</div><div class="lbl">Modules</div></div>
            <div><div class="num">free</div><div class="lbl">For all</div></div>
          </div>
          <div class="foot">
            <div class="next"><span class="next-lbl">Coming soon</span>New modules in development</div>
            <span class="arrow">Start a course</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ ACTIVITY STRIP ============ -->
  <section class="activity">
    <div class="activity-inner">
      <div>
        <div class="eyebrow">Recent activity</div>
        <h3>What's moved lately.</h3>
        <p class="lede">A snapshot of what's happening across the coalition &mdash; letters placed, awards received, initiatives launched.</p>
      </div>

      <ul class="activity-feed">
        <li>
          <time>Feb 2026</time>
          <div class="what"><span class="pill">McClintock</span>Featured in <strong>AAAS Member Spotlight</strong> for mobilizing scientists nationwide</div>
          <div class="where">National · AAAS</div>
        </li>
        <li>
          <time>Feb 2026</time>
          <div class="what"><span class="pill">McClintock</span>Recipient of the <strong>Research!America "Meeting the Moment for Public Health" Award</strong></div>
          <div class="where">National · Research!America</div>
        </li>
        <li>
          <time>Dec 2025</time>
          <div class="what"><span class="pill navy">Hill Day</span>Coverage in <strong>Forbes</strong>: students advocating for science funding</div>
          <div class="where">DC · Hill visits</div>
        </li>
        <li>
          <time>Sep 2025</time>
          <div class="what"><span class="pill">McClintock</span>Op-ed in <strong>Science</strong> on connecting scientists and communities</div>
          <div class="where">National · Editorial</div>
        </li>
        <li>
          <time>Jun 2025</time>
          <div class="what"><span class="pill">McClintock</span>First cycle hits <strong>50 states</strong> &mdash; covered by Cornell Chronicle and The New York Times</div>
          <div class="where">National · Cycle 1</div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ PRESS ============ -->
  <section class="press" id="press">
    <div class="press-inner">
      <div class="press-head">
        <h3>SNAP <em>in the press.</em></h3>
        <p class="lede">Coverage of the coalition's work &mdash; letters placed, hill days reported, members quoted on the science of the day.</p>
      </div>
      <ul class="press-list">
        {recentPress.map((article) => (
          <li>
            <div class="source">{article.source}</div>
            <a class="head" href={article.website} target="_blank" rel="noopener">{article.headline}</a>
            <time>{formatDate(article.date)}</time>
          </li>
        ))}
      </ul>
      <div style="margin-top: 28px;">
        <a class="btn btn-ghost-dark" href={`${base}press/`}>All press →</a>
      </div>
    </div>
  </section>

  <!-- ============ JOIN ============ -->
  <section class="join" id="join">
    <div class="join-inner">
      <div class="eyebrow">Join us</div>
      <h2>Ready to<br/>Get Involved?</h2>
      <p class="lede">Whether you’re part of an established science policy group or an individual advocate, you’re welcome here.</p>

      <div class="join-grid">
        <a class="join-card" href={`${base}initiatives/`}>
          <div class="tag">For Researchers</div>
          <h3>Join an initiative</h3>
          <p>Plug into McClintock Letters, congressional visits, or our Stance on Science campaign. Most initiatives run on multi-month cycles.</p>
          <span class="arrow">Open initiatives</span>
        </a>
        <a class="join-card" href={`${base}newsletters/`}>
          <div class="tag">For Everyone</div>
          <h3>The SNAP newsletter</h3>
          <p>One newsletter, once a month. Letters that ran, offices we visited, what's coming next.</p>
          <span class="arrow">Read past issues</span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ANNOUNCEMENT BAR */
  .announce-bar {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 20px;
    background: var(--orange); color: white;
    font-family: var(--accent); font-weight: 600; font-size: 14px;
    text-decoration: none; text-align: center;
    transition: background .2s ease;
  }
  .announce-bar:hover { background: var(--navy); }
  .announce-bar strong { font-weight: 700; }

  /* INITIATIVES INTRO */
  .intro-strip {
    max-width: var(--container); margin: 64px auto 0;
    padding: 36px 32px 0;
    display: grid; grid-template-columns: 1fr 1.2fr;
    gap: 48px; align-items: end;
    border-top: 1px solid var(--hairline);
  }
  .intro-strip .lede { color: var(--muted); max-width: 520px; }

  .initiatives { padding: 36px 0 100px; }
  .init-spotlight { max-width: var(--container); margin: 36px auto 24px; padding: 0 32px; }
  .spotlight-card {
    display: grid; grid-template-columns: 1.3fr 1fr;
    background: white; border: 1px solid var(--hairline);
    border-radius: 8px; overflow: hidden;
    box-shadow: 0 8px 24px rgba(20,33,58,0.06);
  }
  .spotlight-body { padding: 48px 52px; display: flex; flex-direction: column; justify-content: center; }
  .spotlight-body .init-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--accent); font-weight: 700; font-size: 10.5px;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--orange);
    margin-bottom: 16px;
  }
  .spotlight-body .init-tag .live-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--orange);
    box-shadow: 0 0 0 4px rgba(232,145,66,0.18);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 4px rgba(232,145,66,0.18); }
    50% { box-shadow: 0 0 0 7px rgba(232,145,66,0.08); }
  }
  .spotlight-body h3 {
    font-family: var(--display); font-weight: 700;
    color: var(--navy); font-size: 56px; letter-spacing: -0.03em; line-height: 0.98;
  }
  .spotlight-body p { font-size: 17px; line-height: 1.65; color: var(--body); margin-top: 16px; max-width: 480px; }
  .spotlight-body p .em { color: var(--navy); font-weight: 600; }
  .spotlight-counts {
    margin-top: 28px; display: grid; grid-template-columns: repeat(4, auto);
    gap: 32px; padding: 20px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .spotlight-counts > div .num {
    font-family: var(--display); font-weight: 700; font-size: 36px;
    color: var(--navy); letter-spacing: -0.025em; line-height: 1;
  }
  .spotlight-counts > div .lbl {
    font-family: var(--accent); font-weight: 600; font-size: 10px;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
    margin-top: 6px;
  }
  .spotlight-cta { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }

  .spotlight-portrait {
    position: relative; min-height: 480px;
    background: linear-gradient(155deg, var(--peach-tint) 0%, var(--peach) 60%, var(--orange-soft) 100%);
  }
  .spotlight-portrait .portrait-fab {
    position: absolute; inset: 0;
    background:
      repeating-linear-gradient(135deg, rgba(255,255,255,0.06) 0 10px, transparent 10px 22px),
      radial-gradient(ellipse at 30% 30%, rgba(232,145,66,0.4), transparent 60%);
  }
  .spotlight-portrait .portrait-stamp {
    position: absolute; left: 28px; top: 28px;
    background: rgba(255,255,255,0.92);
    padding: 6px 12px; border-radius: 4px;
    font-family: var(--accent); font-weight: 700; font-size: 10px;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--navy);
  }
  .spotlight-portrait .portrait-caption {
    position: absolute; left: 28px; right: 28px; bottom: 28px;
    background: rgba(255,255,255,0.94);
    padding: 14px 16px; border-radius: 4px;
    border-left: 3px solid var(--orange);
  }
  .spotlight-portrait .portrait-caption .who {
    font-family: var(--display); font-weight: 700; font-size: 15px;
    color: var(--navy); letter-spacing: -0.005em;
  }
  .spotlight-portrait .portrait-caption .desc {
    font-family: var(--accent); font-weight: 500; font-style: italic;
    font-size: 12.5px; line-height: 1.5; color: var(--muted);
    margin-top: 4px;
  }
  .spotlight-portrait .portrait-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  /* 2x2 grid */
  .init-grid {
    max-width: var(--container); margin: 0 auto; padding: 0 32px;
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  /* ACTIVITY */
  .activity {
    background: var(--warm);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 72px 0;
  }
  .activity-inner {
    max-width: var(--container); margin: 0 auto; padding: 0 32px;
    display: grid; grid-template-columns: 1fr 2.2fr;
    gap: 64px; align-items: start;
  }
  .activity h3 {
    font-family: var(--display); font-weight: 700;
    color: var(--navy); font-size: 42px; letter-spacing: -0.025em;
    line-height: 1; margin-top: 4px;
  }
  .activity .lede {
    font-family: var(--accent); font-weight: 500; font-size: 15.5px;
    line-height: 1.55; color: var(--muted); margin-top: 14px; max-width: 320px;
  }
  .activity-feed { list-style: none; display: grid; gap: 4px; padding: 0; }
  .activity-feed li {
    display: grid; grid-template-columns: 110px 1fr auto;
    gap: 24px; padding: 18px 4px;
    border-top: 1px solid var(--hairline);
    align-items: baseline;
  }
  .activity-feed li:last-child { border-bottom: 1px solid var(--hairline); }
  .activity-feed time {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .activity-feed .what {
    font-family: var(--display); font-weight: 600; font-size: 16.5px;
    color: var(--navy); letter-spacing: -0.005em;
  }
  .activity-feed .what .pill { margin-right: 10px; vertical-align: 1px; }
  .activity-feed .where {
    font-family: var(--accent); font-weight: 500; font-size: 11.5px;
    color: var(--muted); letter-spacing: 0.04em;
  }

  /* PRESS */
  .press { padding: 100px 0; background: white; }
  .press-inner { max-width: var(--container); margin: 0 auto; padding: 0 32px; }
  .press-head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 32px; flex-wrap: wrap; gap: 16px; }
  .press-head h3 {
    font-family: var(--display); font-weight: 700;
    color: var(--navy); font-size: 56px; letter-spacing: -0.03em;
    line-height: 0.96;
  }
  .press-head h3 em { color: var(--orange); font-style: italic; }
  .press-head .lede {
    font-family: var(--accent); font-weight: 500; font-size: 16px;
    color: var(--muted); max-width: 380px;
  }

  /* JOIN */
  .join { background: var(--navy); color: white; padding: 110px 0; position: relative; overflow: hidden; }
  .join::before {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(232,145,66,0.22), transparent 50%),
      radial-gradient(circle at 10% 90%, rgba(194,195,84,0.12), transparent 45%);
    pointer-events: none;
  }
  .join-inner { max-width: var(--container); margin: 0 auto; padding: 0 32px; position: relative; }
  .join .eyebrow { color: var(--orange-soft); }
  .join .eyebrow::before { background: var(--orange-soft); }
  .join h2 {
    font-family: var(--display); font-weight: 700;
    color: white; font-size: 72px; letter-spacing: -0.03em; line-height: 0.96;
    max-width: 780px;
  }
  .join .lede {
    font-family: var(--accent); font-weight: 500; font-size: 20px;
    line-height: 1.5; color: rgba(255,255,255,0.86);
    max-width: 720px; margin-top: 18px;
  }
  .join-grid { margin-top: 52px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .join-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 8px; padding: 28px;
    display: grid; gap: 14px;
    text-decoration: none; color: inherit;
    transition: all .2s ease;
  }
  .join-card:hover { background: rgba(255,255,255,0.08); border-color: var(--orange); transform: translateY(-2px); }
  .join-card .tag {
    font-family: var(--accent); font-weight: 700; font-size: 10px;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--orange-soft);
  }
  .join-card h3 {
    font-family: var(--display); font-weight: 700; font-size: 24px;
    color: white; letter-spacing: -0.015em; line-height: 1.15;
  }
  .join-card p { font-size: 14.5px; line-height: 1.55; color: rgba(255,255,255,0.72); }
  .join-card .arrow {
    margin-top: 4px;
    font-family: var(--accent); font-weight: 700; font-size: 11.5px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--orange);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .join-card .arrow::after { content: '→'; transition: transform .2s; }
  .join-card:hover .arrow::after { transform: translateX(4px); }

  @media (max-width: 1080px) {
    .spotlight-card { grid-template-columns: 1fr; }
    .spotlight-body { padding: 36px 32px; }
    .spotlight-portrait { min-height: 320px; }
    .init-grid { grid-template-columns: 1fr; }
    .activity-inner { grid-template-columns: 1fr; gap: 24px; }
    .join-grid { grid-template-columns: 1fr; }
    .intro-strip { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    h1.display { font-size: 52px; }
    .intro-strip h2.display { font-size: 40px; }
    .spotlight-body h3 { font-size: 40px; }
    .spotlight-counts { grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .press-head h3 { font-size: 38px; }
    .join h2 { font-size: 44px; }
    .activity-feed li { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
