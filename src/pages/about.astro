---
import PageLayout from '../layouts/PageLayout.astro';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { join } from 'path';

const orgs = parse(readFileSync(join(process.cwd(), 'src/data/member_orgs.yaml'), 'utf-8')) as Array<{
  name: string;
  photo: string;
  email: string;
  bluesky: string;
  instagram: string;
  linkedin: string;
  website: string;
}>;
---

<PageLayout
  title="About"
  eyebrow="Who we are"
  lede="A coalition of early-career scientists mobilizing for large-scale initiatives and bridging the gaps between scientists, their communities, and the general public."
>
  <div class="cat-head">
    <h2>Member Organizations</h2>
    <span class="cat-count">{orgs.length} {orgs.length === 1 ? 'organization' : 'organizations'}</span>
  </div>

  <div class="org-grid">
    {orgs.map(org => (
      <div class="org-card">
        <div class="org-logo-wrapper">
          <img
            src={`${import.meta.env.BASE_URL}images/about/${org.photo}`}
            alt={`${org.name} logo`}
            class="org-logo"
            loading="lazy"
          />
        </div>
        <div class="org-info">
          <h4>{org.name}</h4>
          <div class="social-links">
            {org.website && (
              <a href={org.website} target="_blank" rel="noopener" aria-label="Website">
                <i class="fa-solid fa-link"></i>
              </a>
            )}
            {org.email && (
              <a href={`mailto:${org.email}`} aria-label="Email">
                <i class="fa-solid fa-envelope"></i>
              </a>
            )}
            {org.bluesky && (
              <a href={`https://bsky.app/profile/${org.bluesky}`} target="_blank" rel="noopener" aria-label="Bluesky">
                <i class="fa-brands fa-bluesky"></i>
              </a>
            )}
            {org.instagram && (
              <a href={`https://www.instagram.com/${org.instagram}`} target="_blank" rel="noopener" aria-label="Instagram">
                <i class="fa-brands fa-instagram"></i>
              </a>
            )}
            {org.linkedin && (
              <a href={`https://www.linkedin.com/company/${org.linkedin}/`} target="_blank" rel="noopener" aria-label="LinkedIn">
                <i class="fa-brands fa-linkedin"></i>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</PageLayout>

<style>
  .cat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 28px;
    border-bottom: 1px solid var(--hairline);
  }
  .cat-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 32px;
    color: var(--navy); letter-spacing: -0.02em; margin: 0;
  }
  .cat-count {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }

  .org-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  /* Card anatomy follows .init-card: hairline border, accent bar on hover, lift. */
  .org-card {
    position: relative; overflow: hidden;
    display: flex; gap: 18px; align-items: center;
    background: white;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: 22px 24px;
    transition: all .2s ease;
  }
  .org-card::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 4px; background: var(--orange);
    transform: scaleY(0.3); transform-origin: top;
    transition: transform .3s ease;
  }
  .org-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
    border-color: var(--orange);
  }
  .org-card:hover::before { transform: scaleY(1); }

  .org-logo-wrapper {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .org-logo {
    max-width: 72px;
    max-height: 72px;
    object-fit: contain;
  }

  .org-info h4 {
    font-family: var(--display); font-weight: 700; font-size: 19px;
    color: var(--navy); letter-spacing: -0.01em;
    line-height: 1.25; margin-bottom: 10px;
  }

  .org-info .social-links a {
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.875rem;
  }
</style>
