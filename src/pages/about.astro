</PageLayout>

<style>
  .about-intro {
    font-family: var(--accent); font-weight: 500; font-size: 19px;
    line-height: 1.55; color: var(--body);
    max-width: 720px; margin-bottom: 56px;
  }

  .about-section { margin-bottom: 48px; }
  .mission {
    font-size: 17px; line-height: 1.65; color: var(--body);
    max-width: 760px; margin: 0;
  }

  .about-links {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px; margin-bottom: 64px;
  }

  /* Card anatomy follows .init-card: hairline border, accent bar on hover, lift. */
  .about-link {
    position: relative; overflow: hidden;
    display: grid; gap: 8px; align-content: start;
    background: white;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: 24px 26px 22px;
    text-decoration: none; color: inherit;
    transition: all .2s ease;
  }
  .about-link::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 4px; background: var(--card-color, var(--orange));
    transform: scaleY(0.3); transform-origin: top;
    transition: transform .3s ease;
  }
  .about-link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
    border-color: var(--card-color, var(--orange));
  }
  .about-link:hover::before { transform: scaleY(1); }

  .c-pubs { --card-color: var(--navy); }
  .c-events { --card-color: var(--orange); }

  .about-link h4 {
    font-family: var(--display); font-weight: 700; font-size: 19px;
    color: var(--navy); letter-spacing: -0.01em; line-height: 1.25;
  }
  .about-link p { font-size: 14.5px; line-height: 1.55; color: var(--muted); }
  .about-link .arrow {
    font-family: var(--accent); font-weight: 700; font-size: 10.5px;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--card-color, var(--orange));
    display: inline-flex; gap: 6px; align-items: center;
    margin-top: 4px;
  }
  .about-link .arrow::after { content: '→'; transition: transform .2s ease; }
  .about-link:hover .arrow::after { transform: translateX(3px); }

  .cat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 28px;
    border-bottom: 1px solid var(--hairline);
  }
  .cat-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 32px;
    color: var(--navy); letter-spacing: -0.02em; margin: 0;
  }
  .cat-count {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }

  .org-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  /* Card anatomy follows .init-card: hairline border, accent bar on hover, lift. */
  .org-card {
    position: relative; overflow: hidden;
    display: flex; gap: 18px; align-items: center;
    background: white;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: 22px 24px;
    transition: all .2s ease;
  }
  .org-card::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 4px; background: var(--orange);
    transform: scaleY(0.3); transform-origin: top;
    transition: transform .3s ease;
  }
  .org-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
    border-color: var(--orange);
  }
  .org-card:hover::before { transform: scaleY(1); }

  .org-logo-wrapper {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .org-logo {
    max-width: 72px;
    max-height: 72px;
    object-fit: contain;
  }

  .org-info h4 {
    font-family: var(--display); font-weight: 700; font-size: 19px;
    color: var(--navy); letter-spacing: -0.01em;
    line-height: 1.25; margin-bottom: 10px;
  }

  .org-info .social-links a {
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.875rem;
  }
</style>
