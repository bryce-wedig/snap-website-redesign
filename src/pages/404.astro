---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Page Not Found"
  eyebrow="404"
  lede="The page you're looking for doesn't exist or has been moved."
>
  <div class="nf-actions">
    <a href={import.meta.env.BASE_URL} class="btn btn-primary">Go home</a>
    <a href={`${import.meta.env.BASE_URL}initiatives/`} class="btn btn-ghost-dark">Browse initiatives</a>
  </div>
</PageLayout>

<style>
  .nf-actions { display: flex; gap: 14px; flex-wrap: wrap; }
</style>
