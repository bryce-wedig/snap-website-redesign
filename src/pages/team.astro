---
import PageLayout from '../layouts/PageLayout.astro';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { join } from 'path';

const members = parse(readFileSync(join(process.cwd(), 'src/data/members.yaml'), 'utf-8')) as Array<{
  name: string;
  pronouns: string;
  photo: string;
  info: string;
  email: string;
  bluesky: string;
  medium: string;
  instagram: string;
  linkedin: string;
  twitter: string;
  website: string;
}>;
---

<PageLayout
  title="Team"
  eyebrow="Meet the coalition"
  lede="The early-career researchers organizing SNAP's initiatives across the country."
>
  <div class="cat-head">
    <h2>Organizing Members</h2>
    <span class="cat-count">{members.length} {members.length === 1 ? 'member' : 'members'}</span>
  </div>

  <div class="team-grid">
    {members.map(member => (
      <div class="team-card">
        <img
          src={`${import.meta.env.BASE_URL}images/team/${member.photo}`}
          alt={`Photo of ${member.name}`}
          class="member-photo"
          loading="lazy"
        />
        <div class="member-info">
          <h4>{member.name}</h4>
          {member.pronouns && <span class="pronouns">{member.pronouns}</span>}
          <p class="member-bio">{member.info}</p>
          <div class="social-links">
            {member.website && (
              <a href={member.website} target="_blank" rel="noopener" aria-label="Website">
                <i class="fa-solid fa-link"></i>
              </a>
            )}
            {member.email && (
              <a href={`mailto:${member.email}`} aria-label="Email">
                <i class="fa-solid fa-envelope"></i>
              </a>
            )}
            {member.linkedin && (
              <a href={`https://www.linkedin.com/in/${member.linkedin}/`} target="_blank" rel="noopener" aria-label="LinkedIn">
                <i class="fa-brands fa-linkedin"></i>
              </a>
            )}
            {member.bluesky && (
              <a href={`https://bsky.app/profile/${member.bluesky}`} target="_blank" rel="noopener" aria-label="Bluesky">
                <i class="fa-brands fa-bluesky"></i>
              </a>
            )}
            {member.medium && (
              <a href={`https://medium.com/@${member.medium}`} target="_blank" rel="noopener" aria-label="Medium">
                <i class="fa-brands fa-medium"></i>
              </a>
            )}
            {member.instagram && (
              <a href={`https://www.instagram.com/${member.instagram}`} target="_blank" rel="noopener" aria-label="Instagram">
                <i class="fa-brands fa-instagram"></i>
              </a>
            )}
            {member.twitter && (
              <a href={`https://x.com/${member.twitter}`} target="_blank" rel="noopener" aria-label="X (Twitter)">
                <i class="fa-brands fa-x-twitter"></i>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</PageLayout>

<style>
  .cat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 28px;
    border-bottom: 1px solid var(--hairline);
  }
  .cat-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 32px;
    color: var(--navy); letter-spacing: -0.02em; margin: 0;
  }
  .cat-count {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr));
    gap: 20px;
  }

  /* Card anatomy follows .init-card: hairline border, accent bar on hover, lift. */
  .team-card {
    position: relative; overflow: hidden;
    display: flex; gap: 22px; align-items: flex-start;
    background: white;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: 28px;
    transition: all .2s ease;
  }
  .team-card::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 4px; background: var(--orange);
    transform: scaleY(0.3); transform-origin: top;
    transition: transform .3s ease;
  }
  .team-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
    border-color: var(--orange);
  }
  .team-card:hover::before { transform: scaleY(1); }

  .team-card .member-photo { flex-shrink: 0; }

  .member-info h4 {
    font-family: var(--display); font-weight: 700; font-size: 22px;
    color: var(--navy); letter-spacing: -0.015em;
    line-height: 1.2; margin-bottom: 4px;
  }

  .pronouns {
    display: block;
    font-family: var(--accent); font-weight: 600; font-size: 10.5px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .member-bio {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--body);
    margin-bottom: 14px;
  }

  @media (max-width: 600px) {
    .team-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
