---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allCourses = await getCollection('courses');
const available = allCourses.filter(c => !c.data.comingSoon);
const comingSoon = allCourses.filter(c => c.data.comingSoon);
---

<PageLayout title="Courses" eyebrow="Education" lede="Short, self-paced modules from the SNAP coalition. Free for members and the public.">
  {available.length > 0 && (
    <section class="course-section">
      <div class="cat-head">
        <h2>Available Now</h2>
        <span class="cat-count">{available.length} {available.length === 1 ? 'course' : 'courses'}</span>
      </div>
      <div class="course-grid">
        {available.map(course => (
          <a href={`${base}courses/${course.id}/`} class="init-card c-courses">
            <h4>{course.data.title}</h4>
            <div class="foot">
              <div class="next"><span class="next-lbl">Format</span>Self-paced</div>
              <span class="arrow">Start course</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {comingSoon.length > 0 && (
    <section class="course-section">
      <div class="cat-head">
        <h2>Coming Soon</h2>
        <span class="cat-count">{comingSoon.length} in development</span>
      </div>
      <div class="course-grid">
        {comingSoon.map(course => (
          <div class="init-card c-courses is-upcoming">
            <h4>{course.data.title}</h4>
            <div class="foot">
              <div class="next"><span class="next-lbl">Status</span>Coming soon</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</PageLayout>

<style>
  .course-section { margin-bottom: 64px; }
  .course-section:last-child { margin-bottom: 0; }

  .cat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 24px;
    border-bottom: 1px solid var(--hairline);
  }
  .cat-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 32px;
    color: var(--navy); letter-spacing: -0.02em; margin: 0;
  }
  .cat-count {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }

  .course-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

  /* Unreleased courses keep the card anatomy but drop the interactive affordances. */
  .init-card.is-upcoming { cursor: default; background: var(--warm); }
  .init-card.is-upcoming:hover {
    transform: none; box-shadow: none; border-color: var(--hairline);
  }
  .init-card.is-upcoming:hover::before { transform: scaleY(0.3); }

  @media (max-width: 800px) {
    .course-grid { grid-template-columns: 1fr; }
  }
</style>
