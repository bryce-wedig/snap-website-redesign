---
import PageLayout from '../layouts/PageLayout.astro';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { join } from 'path';

const press = parse(readFileSync(join(process.cwd(), 'src/data/press.yaml'), 'utf-8')) as Array<{
  headline: string;
  source: string;
  date: string;
  website: string;
  category: string | string[];
}>;

const pubsReports = parse(readFileSync(join(process.cwd(), 'src/data/pubs_reports.yaml'), 'utf-8')) as Array<{
  headline: string;
  source: string;
  date: string;
  website: string;
}>;

// Filter out entries without headlines
const validPress = press.filter(a => a.headline && a.source);
const validPubs = pubsReports.filter(a => a.headline && a.source);

function formatDate(d: string): string {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<PageLayout
  title="Press"
  eyebrow="In the press"
  lede="Publication and report mentions, and press coverage of SNAP and the coalition's work."
>
  {validPubs.length > 0 && (
    <section class="press-section">
      <div class="cat-head">
        <h2>Publications &amp; Reports</h2>
        <span class="cat-count">{validPubs.length} {validPubs.length === 1 ? 'mention' : 'mentions'}</span>
      </div>
      <ul class="press-list">
        {validPubs.map(article => (
          <li>
            <div class="source">{article.source}</div>
            <a class="head" href={article.website} target="_blank" rel="noopener">{article.headline}</a>
            <time>{formatDate(article.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="press-section">
    <div class="cat-head">
      <h2>Press Mentions</h2>
      <span class="cat-count">{validPress.length} {validPress.length === 1 ? 'article' : 'articles'}</span>
    </div>
    <ul class="press-list">
      {validPress.map(article => (
        <li>
          <div class="source">{article.source}</div>
          <a class="head" href={article.website} target="_blank" rel="noopener">{article.headline}</a>
          <time>{formatDate(article.date)}</time>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>

<style>
  /* Rows come from the global .press-list component in global.css — the same one
     the home page uses. Only the section chrome is local. */
  .press-section { margin-bottom: 64px; }
  .press-section:last-child { margin-bottom: 0; }

  .cat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 0;
    border-bottom: 1px solid var(--hairline);
  }
  /* The head rule already closes the top of the ledger. */
  .press-list li:first-child { border-top: none; }
  .cat-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 32px;
    color: var(--navy); letter-spacing: -0.02em; margin: 0;
  }
  .cat-count {
    font-family: var(--accent); font-weight: 600; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
</style>
