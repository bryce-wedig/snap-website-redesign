---
// Home page hero — "The map is the hero" (design handoff: Direction B).
// A full-bleed interactive Leaflet map with a floating intro panel and
// "field photos" pinned to the place they were taken; a dashed connector ties
// each photo to a marker at its exact city and tracks the map as it moves.
//
// Configuration lives entirely in data:
//   src/data/home_hero.yaml    — panel copy, map view, cycle settings, photo sets
//   src/data/map_markers.yaml  — member-city (orange) and org (navy) markers
//   src/data/stance_states.yaml — the Stance on Science state teams (shared
//                                 with the initiative page's map)
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { join } from 'path';
import { loadStates } from '../lib/stance';

const base = import.meta.env.BASE_URL;
const imageBase = `${base}images/`;

const hero = parse(
  readFileSync(join(process.cwd(), 'src/data/home_hero.yaml'), 'utf-8')
) as {
  map: {
    center: [number, number]; zoom: number; min_zoom: number; max_zoom: number;
    fit_max_zoom?: number;
  };
  panel: {
    eyebrow: string; heading: string; heading_em: string; lede: string;
    stats: { num: string; label: string }[];
    primary: { label: string; href: string };
    ghost: { label: string; href: string };
  };
  cycle: { enabled: boolean; interval_ms: number };
  slideshow: {
    enabled: boolean;
    slides: { id: string; eyebrow: string; sub?: string; duration_ms: number }[];
  };
  photo_sets: {
    name: string;
    photos: {
      id: string; src: string; place: string; lat: number; lng: number;
      object_position?: string;
      card: { left?: number; right?: number; top?: number; bottom?: number };
    }[];
  }[];
};

const markers = parse(
  readFileSync(join(process.cwd(), 'src/data/map_markers.yaml'), 'utf-8')
) as {
  cities: { lat: number; lng: number; name: string }[];
  orgs: { lat: number; lng: number; name: string; location?: string }[];
};

// Published McClintock letters (one dot per place). The source CSV has many
// rows per city; we keep the rows marked "Published" and de-duplicate by place.
function parseCsv(text: string): string[][] {
  const lines = text.split(/\r?\n/).filter((l) => l.trim().length);
  const out: string[][] = [];
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i];
    const cols: string[] = [];
    let cur = '', q = false;
    for (let j = 0; j < line.length; j++) {
      const ch = line[j];
      if (q) {
        if (ch === '"') { if (line[j + 1] === '"') { cur += '"'; j++; } else q = false; }
        else cur += ch;
      } else if (ch === '"') q = true;
      else if (ch === ',') { cols.push(cur); cur = ''; }
      else cur += ch;
    }
    cols.push(cur);
    out.push(cols);
  }
  return out;
}

const letterRows = parseCsv(
  readFileSync(join(process.cwd(), 'src/data/mcclintock_geo.csv'), 'utf-8')
).filter((r) => (r[3] || '').trim() === 'Published');

const seenLetters = new Set<string>();
const letters = letterRows
  .map((r) => ({ name: r[0].trim(), lat: parseFloat(r[1]), lng: parseFloat(r[2]) }))
  .filter((l) => l.name && Number.isFinite(l.lat) && Number.isFinite(l.lng))
  .filter((l) => (seenLetters.has(l.name) ? false : (seenLetters.add(l.name), true)));

// Stance on Science teams — the same registry the initiative page's map reads,
// so a new state team lights up here and there from a single edit. Names must
// match public/data/us-states.geojson (full state names); each state links to
// its own page, as the initiative page's map does.
const stanceStates = loadStates().map((s) => ({
  name: s.name,
  url: `${base}initiatives/stance-on-science/states/${s.code}/`,
}));

const site = parse(readFileSync(join(process.cwd(), 'src/data/site.yaml'), 'utf-8'));

const socials = [
  { name: 'Bluesky', icon: 'fa-brands fa-bluesky', url: site.social?.bluesky },
  { name: 'Instagram', icon: 'fa-brands fa-instagram', url: site.social?.instagram },
  { name: 'LinkedIn', icon: 'fa-brands fa-linkedin-in', url: site.social?.linkedin },
  { name: 'Medium', icon: 'fa-brands fa-medium', url: site.social?.medium },
].filter((s) => s.url);

const withBase = (href: string) => `${base}${href.replace(/^\//, '')}`;

// Render the first set server-side for fast first paint and no-JS fallback;
// the client script reuses these cards and rebuilds them when cycling sets.
const firstSet = hero.photo_sets[0]?.photos ?? [];
const cardStyle = (card: { left?: number; right?: number; top?: number; bottom?: number }) =>
  (['left', 'right', 'top', 'bottom'] as const)
    .filter((k) => card[k] != null)
    .map((k) => `${k}:${card[k]}px`)
    .join(';');

// Config handed to the client script (drives markers, connectors, and cycling).
const clientConfig = {
  imageBase,
  map: {
    center: hero.map.center,
    zoom: hero.map.zoom,
    minZoom: hero.map.min_zoom,
    maxZoom: hero.map.max_zoom,
    fitMaxZoom: hero.map.fit_max_zoom ?? 6,
  },
  cycle: { enabled: hero.cycle.enabled, intervalMs: hero.cycle.interval_ms },
  cities: markers.cities,
  orgs: markers.orgs,
  letters,
  slideshow: {
    enabled: hero.slideshow?.enabled ?? false,
    slides: (hero.slideshow?.slides ?? []).map((s) => ({
      id: s.id, eyebrow: s.eyebrow, sub: s.sub ?? '', durationMs: s.duration_ms,
    })),
  },
  stanceStates,
  geojsonUrl: `${base}data/us-states.geojson`,
  sets: hero.photo_sets.map((set) => ({
    name: set.name,
    photos: set.photos.map((p) => ({
      id: p.id,
      src: p.src,
      place: p.place,
      lat: p.lat,
      lng: p.lng,
      objectPosition: p.object_position ?? 'center',
      card: p.card,
    })),
  })),
};
---

<section class="home-hero" aria-label="SNAP coalition map">
  <div class="home-hero-stage" id="home-hero-stage">
    <div class="home-hero-map" id="home-hero-map"></div>

    <!-- connector overlay: above the map tiles (z6), below the photo cards (z10) -->
    <svg id="home-hero-connectors" aria-hidden="true"></svg>

    <!-- floating intro panel -->
    <div class="home-hero-panel">
      <div class="sh-eyebrow">{hero.panel.eyebrow}</div>
      <h1 class="home-hero-title">
        {hero.panel.heading} <em>{hero.panel.heading_em}</em>
      </h1>
      <p class="home-hero-lede">{hero.panel.lede}</p>

      <div class="home-hero-stats">
        {hero.panel.stats.map((s) => (
          <div>
            <div class="sh-statnum">{s.num}</div>
            <div class="sh-statlbl">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="home-hero-btns">
        <a class="sh-btn primary" href={withBase(hero.panel.primary.href)}>{hero.panel.primary.label}</a>
        <a class="sh-btn ghost" href={withBase(hero.panel.ghost.href)}>{hero.panel.ghost.label}</a>
      </div>

      <div class="home-hero-foot">
        <div class="home-hero-legend">
          <span class="dot orange"></span>Members
          <span class="dot navy"></span>Orgs
        </div>
        <div class="sh-socials">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
              <i class={s.icon}></i>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- pinned field photos (first set; client script swaps sets when cycling) -->
    <div id="home-hero-photos">
      {firstSet.map((p) => (
        <figure class="hero-photo" data-id={p.id} style={cardStyle(p.card)}>
          <img
            src={`${imageBase}${p.src}`}
            alt={`SNAP members in ${p.place}`}
            style={`object-position:${p.object_position ?? 'center'}`}
            loading="lazy"
          />
          <figcaption class="cap">
            <i class="fa-solid fa-location-dot"></i>
            <span>{p.place}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- slideshow progress rail (labels what the map is currently showing) -->
    {hero.slideshow?.enabled && hero.slideshow.slides.length > 0 && (
      <div class="hero-rail" id="hero-rail" role="tablist" aria-label="Map highlights">
        {hero.slideshow.slides.map((s, i) => (
          <button
            type="button"
            class={`rail-item rail-item--${s.id}${i === 0 ? ' active' : ''}`}
            data-index={i}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class="rail-text">
              <span class="rail-eyebrow">{s.eyebrow}</span>
              {s.sub && <span class="rail-sub">{s.sub}</span>}
            </span>
            <span class="rail-track"><span class="rail-fill"></span></span>
          </button>
        ))}
      </div>
    )}
  </div>

  <script type="application/json" id="home-hero-config" set:html={JSON.stringify(clientConfig)} />
</section>

<!-- Leaflet (loaded only on pages that use this component) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline>
(function () {
  function init() {
    if (!window.L) { setTimeout(init, 50); return; }
    var cfg = JSON.parse(document.getElementById('home-hero-config').textContent);

    // Brand colors are read from the design tokens so SVG/Leaflet styling can't
    // drift from global.css. Fallbacks match the tokens' current values.
    function token(name, fallback) {
      var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return v || fallback;
    }
    var C = {
      navy: token('--navy', '#213863'),
      orange: token('--orange', '#E89142'),
      plum: token('--plum', '#310A45'),
    };

    var stage = document.getElementById('home-hero-stage');
    var mapEl = document.getElementById('home-hero-map');
    var svg = document.getElementById('home-hero-connectors');
    var photosEl = document.getElementById('home-hero-photos');
    if (!stage || !mapEl || !svg || !photosEl) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- map ----
    var map = L.map(mapEl, {
      center: cfg.map.center,
      zoom: cfg.map.zoom,
      minZoom: cfg.map.minZoom,
      maxZoom: cfg.map.maxZoom,
      zoomControl: false,
      attributionControl: true,
      scrollWheelZoom: false, // let the page keep scrolling
      dragging: true,
      doubleClickZoom: true,
      touchZoom: true,
      boxZoom: false,
      keyboard: false,
    });
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      maxZoom: 19, attribution: '&copy; OpenStreetMap &copy; CARTO', crossOrigin: true,
    }).addTo(map);

    // Markers carry a wrapper className so slides can dim/brighten whole layers
    // via CSS (.mk-member / .mk-letter on the stage's [data-slide]).
    var pin = function (cls, wrap, size) {
      var s = size || 14;
      return L.divIcon({ html: '<div class="sh-pin ' + cls + '"></div>', className: 'mk ' + wrap, iconSize: [s, s], iconAnchor: [s / 2, s / 2] });
    };
    (cfg.cities || []).forEach(function (c) {
      L.marker([c.lat, c.lng], { icon: pin('', 'mk-member'), autoPan: false }).addTo(map).bindPopup(c.name);
    });
    (cfg.orgs || []).forEach(function (o) {
      var html = '<b>' + o.name + '</b>' + (o.location ? '<br>' + o.location : '');
      L.marker([o.lat, o.lng], { icon: pin('org', 'mk-member'), autoPan: false }).addTo(map).bindPopup(html);
    });
    (cfg.letters || []).forEach(function (l) {
      L.marker([l.lat, l.lng], { icon: pin('letter', 'mk-letter', 10), autoPan: false }).addTo(map).bindPopup(l.name);
    });

    // The slideshow assigns these so the stance states can hold their slide
    // while a visitor reaches for one (the layer is otherwise pulled at 6s).
    var pauseShow = function () {}, resumeShow = function () {};

    // Stance-on-Science states: filled polygons, added/removed per slide. Each
    // one links to its state page, like the initiative page's map.
    var stanceLayer = null, stanceUrls = {};
    (cfg.stanceStates || []).forEach(function (s) { stanceUrls[s.name] = s.url; });
    if (cfg.geojsonUrl && (cfg.stanceStates || []).length) {
      fetch(cfg.geojsonUrl).then(function (r) { return r.json(); }).then(function (gj) {
        var feats = (gj.features || []).filter(function (f) {
          return f.properties && stanceUrls[f.properties.name];
        });
        stanceLayer = L.geoJSON({ type: 'FeatureCollection', features: feats }, {
          className: 'stance-state',
          style: { color: C.plum, weight: 1.5, fillColor: C.plum, fillOpacity: 0.55, opacity: 0.9 },
          onEachFeature: function (feature, layer) {
            var name = feature.properties.name;
            var url = stanceUrls[name];
            var go = function () { window.location.href = url; };

            layer.bindTooltip(name + ' — view responses', { sticky: true });
            layer.on('click', go);
            layer.on('mouseover', function () {
              layer.setStyle({ fillOpacity: 0.75 });
              pauseShow();
            });
            layer.on('mouseout', function () {
              layer.setStyle({ fillOpacity: 0.55 });
              resumeShow();
            });
            // Re-applied on every add: switching slides removes the layer,
            // which throws away (and later recreates) these SVG paths.
            layer.on('add', function () {
              // a slide change can remove the layer mid-hover, with no mouseout
              layer.setStyle({ fillOpacity: 0.55 });
              var el = layer.getElement();
              if (!el) return;
              el.setAttribute('role', 'link');
              el.setAttribute('tabindex', '0');
              el.setAttribute('aria-label', name + ' — view Stance on Science responses');
              el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
              });
              el.addEventListener('focus', pauseShow);
              el.addEventListener('blur', resumeShow);
            });
          },
        });
        if (stage.getAttribute('data-slide') === 'stance') { stanceLayer.addTo(map); focusSlide('stance'); }
      }).catch(function () {});
    }

    // ---- auto-zoom: each slide frames *all* of its own content ----
    // Everything the active slide shows (member/org pins, letter dots, or the
    // filled Stance states) has to land inside the space the floating panel and
    // the rail leave free — those insets are measured from the live DOM so the
    // responsive layouts, and a resized window, stay honest.
    function boundsOf(points) {
      if (!points || !points.length) return null;
      var b = L.latLngBounds([]);
      points.forEach(function (p) {
        if (Number.isFinite(p.lat) && Number.isFinite(p.lng)) b.extend(L.latLng(p.lat, p.lng));
      });
      return b.isValid() ? b : null;
    }
    var memberBounds = boundsOf((cfg.cities || []).concat(cfg.orgs || []));
    var letterBounds = boundsOf(cfg.letters || []);

    function slideBounds(id) {
      if (id === 'stance') {
        if (!stanceLayer) return null;
        var b = stanceLayer.getBounds();
        return b && b.isValid() ? b : null;
      }
      if (id === 'mcclintock') return letterBounds;
      return memberBounds;
    }

    // Insets for the UI floating over the map. Each floating block is charged to
    // one edge: a tall column (the desktop panel) to left/right, a wide band
    // (the panel once it stacks on phones) to top/bottom, and a small corner
    // block (the rail) to whichever of the two costs the map less room.
    function fitPadding() {
      var s = stage.getBoundingClientRect();
      var pad = { top: 30, right: 30, bottom: 46, left: 30 }; // bottom: attribution strip
      var gap = 18; // breathing room between the UI edge and the outermost pin
      [stage.querySelector('.home-hero-panel'), document.getElementById('hero-rail')]
        .forEach(function (node) {
          if (!node || node.offsetParent === null) return;
          var r = node.getBoundingClientRect();
          // inset needed on each axis, charged to the edge the block hugs
          var hSide = (r.left - s.left <= s.right - r.right) ? 'left' : 'right';
          var vSide = (r.top - s.top <= s.bottom - r.bottom) ? 'top' : 'bottom';
          var hInset = hSide === 'left' ? r.right - s.left + gap : s.right - r.left + gap;
          var vInset = vSide === 'top' ? r.bottom - s.top + gap : s.bottom - r.top + gap;
          var horizontal;
          if (r.width > s.width * 0.5) horizontal = false;      // wide band
          else if (r.height > s.height * 0.5) horizontal = true; // tall column
          else horizontal = hInset / s.width <= vInset / s.height; // corner block
          if (horizontal) pad[hSide] = Math.max(pad[hSide], hInset);
          else pad[vSide] = Math.max(pad[vSide], vInset);
        });
      // ...but never squeeze the free viewport down to a sliver: past this the
      // map would zoom out further than the content is worth.
      var cap = function (a, b, total) {
        var room = total * 0.62, used = pad[a] + pad[b];
        if (used > room) { var k = room / used; pad[a] *= k; pad[b] *= k; }
      };
      cap('left', 'right', s.width);
      cap('top', 'bottom', s.height);
      return pad;
    }

    var didFit = false; // the opening view snaps; later slide changes animate
    function focusSlide(id, instant) {
      if (!map) return;
      var anim = !reduceMotion && !document.hidden && didFit && !instant;
      didFit = true;
      var b = slideBounds(id);
      if (b) {
        var pad = fitPadding();
        try {
          // flyToBounds falls back to setView when animate is false
          map.flyToBounds(b, {
            paddingTopLeft: [Math.round(pad.left), Math.round(pad.top)],
            paddingBottomRight: [Math.round(pad.right), Math.round(pad.bottom)],
            maxZoom: cfg.map.fitMaxZoom,
            animate: anim, duration: 0.8,
          });
          return;
        } catch (e) {}
      }
      map.flyTo(cfg.map.center, cfg.map.zoom, { animate: anim, duration: 0.8 });
    }

    // A resized stage changes the free space, so re-frame the active slide.
    var refitTimer = null;
    function refit() {
      if (refitTimer) clearTimeout(refitTimer);
      refitTimer = setTimeout(function () {
        map.invalidateSize();
        focusSlide(stage.getAttribute('data-slide') || 'members', true);
      }, 160);
    }

    // ---- photo cards + connectors ----
    var sets = cfg.sets || [];
    var active = 0;
    var photoData = sets.length ? sets[0].photos : [];
    var cards = {};

    function indexCards() {
      cards = {};
      var nodes = photosEl.querySelectorAll('.hero-photo');
      for (var i = 0; i < nodes.length; i++) cards[nodes[i].getAttribute('data-id')] = nodes[i];
    }

    function buildCards(photos) {
      photosEl.innerHTML = '';
      photos.forEach(function (p) {
        var fig = document.createElement('figure');
        fig.className = 'hero-photo';
        fig.setAttribute('data-id', p.id);
        if (p.card.left != null) fig.style.left = p.card.left + 'px';
        if (p.card.right != null) fig.style.right = p.card.right + 'px';
        if (p.card.top != null) fig.style.top = p.card.top + 'px';
        if (p.card.bottom != null) fig.style.bottom = p.card.bottom + 'px';
        var img = document.createElement('img');
        img.src = cfg.imageBase + p.src;
        img.alt = 'SNAP members in ' + p.place;
        img.loading = 'lazy';
        if (p.objectPosition) img.style.objectPosition = p.objectPosition;
        var cap = document.createElement('figcaption');
        cap.className = 'cap';
        cap.innerHTML = '<i class="fa-solid fa-location-dot"></i><span></span>';
        cap.querySelector('span').textContent = p.place;
        fig.appendChild(img);
        fig.appendChild(cap);
        photosEl.appendChild(fig);
      });
      indexCards();
    }

    // point on a rect's border, from its center toward target t
    function edgePoint(x, y, w, h, t) {
      var cx = x + w / 2, cy = y + h / 2;
      var dx = t.x - cx, dy = t.y - cy;
      if (dx === 0 && dy === 0) return { x: cx, y: cy };
      var sx = dx !== 0 ? (w / 2) / Math.abs(dx) : Infinity;
      var sy = dy !== 0 ? (h / 2) / Math.abs(dy) : Infinity;
      var s = Math.min(sx, sy);
      var m = 6; // nudge the start just outside the frame
      var len = Math.hypot(dx, dy);
      return { x: cx + dx * s + (dx / len) * m, y: cy + dy * s + (dy / len) * m };
    }

    var NS = 'http://www.w3.org/2000/svg';
    function el(name, attrs) {
      var n = document.createElementNS(NS, name);
      for (var k in attrs) n.setAttribute(k, attrs[k]);
      return n;
    }

    function recompute() {
      if (!map) return;
      while (svg.firstChild) svg.removeChild(svg.firstChild);
      // connectors belong to the photo cards, which only show on the members slide
      var slide = stage.getAttribute('data-slide');
      if (slide && slide !== 'members') return;
      photoData.forEach(function (p) {
        var card = cards[p.id];
        if (!card || card.offsetParent === null) return; // skip hidden (reflowed) cards
        // project to container pixels — geographically exact, unscaled layout space
        var pt = map.latLngToContainerPoint(L.latLng(p.lat, p.lng));
        var a = edgePoint(card.offsetLeft, card.offsetTop, card.offsetWidth, card.offsetHeight, pt);
        svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: pt.x, y2: pt.y, stroke: C.navy, 'stroke-width': '1.5', 'stroke-dasharray': '2 5', 'stroke-linecap': 'round', opacity: '0.55' }));
        svg.appendChild(el('circle', { cx: a.x, cy: a.y, r: '2.6', fill: C.navy }));
        svg.appendChild(el('circle', { cx: pt.x, cy: pt.y, r: '11', fill: C.orange, opacity: '0.16' }));
        svg.appendChild(el('circle', { cx: pt.x, cy: pt.y, r: '5', fill: C.orange, stroke: '#fff', 'stroke-width': '2.2' }));
      });
    }

    function showSet(i) {
      if (i === active && Object.keys(cards).length) return;
      active = i;
      photoData = sets[i].photos;
      var swap = function () {
        buildCards(photoData);
        requestAnimationFrame(recompute);
        setTimeout(recompute, 120); // after images/layout settle
        if (!reduceMotion) stage.classList.remove('swapping');
      };
      if (reduceMotion) { swap(); return; }
      stage.classList.add('swapping');
      setTimeout(swap, 350); // fade out, then rebuild + fade in
    }

    // reuse the server-rendered first set
    indexCards();

    map.on('move zoom zoomend moveend resize viewreset', recompute);
    map.whenReady(function () {
      // the fit above ran before the container had its final size
      setTimeout(function () {
        map.invalidateSize();
        focusSlide(stage.getAttribute('data-slide') || 'members', true);
        recompute();
      }, 60);
      setTimeout(recompute, 200);
    });
    window.addEventListener('resize', function () { recompute(); refit(); });

    // cycle through sets when more than one is defined
    if (cfg.cycle && cfg.cycle.enabled && sets.length > 1 && !reduceMotion) {
      setInterval(function () { showSet((active + 1) % sets.length); }, cfg.cycle.intervalMs || 7000);
    }

    // ---- slideshow: auto-advance highlight slides + progress rail ----
    var show = cfg.slideshow || {};
    var slides = show.slides || [];
    if (show.enabled && slides.length) {
      var rail = document.getElementById('hero-rail');
      var items = rail ? Array.prototype.slice.call(rail.querySelectorAll('.rail-item')) : [];
      var fills = items.map(function (it) { return it.querySelector('.rail-fill'); });
      var current = -1, timer = null, paused = false;

      function setFill(el, pct, dur) {
        if (!el) return;
        el.style.transition = (dur && !reduceMotion) ? 'height ' + dur + 'ms linear' : 'none';
        el.style.height = pct + '%';
      }

      function applyVisibility(slide) {
        // stance polygons are a real Leaflet layer; add/remove by slide
        if (stanceLayer) {
          if (slide.id === 'stance') { if (!map.hasLayer(stanceLayer)) stanceLayer.addTo(map); }
          else if (map.hasLayer(stanceLayer)) map.removeLayer(stanceLayer);
        }
      }

      function go(i) {
        if (!slides.length) return;
        i = ((i % slides.length) + slides.length) % slides.length;
        var wrapped = i <= current; // looped back to (or jumped above) start → reset fills
        current = i;
        var slide = slides[i];
        stage.setAttribute('data-slide', slide.id);
        applyVisibility(slide);
        focusSlide(slide.id);

        items.forEach(function (it, k) {
          it.classList.toggle('active', k === i);
          it.setAttribute('aria-selected', k === i ? 'true' : 'false');
        });
        // fill: completed slides full, upcoming empty, active animates over its duration
        fills.forEach(function (f, k) {
          if (k < i) setFill(f, 100, 0);
          else if (k > i || wrapped && k !== i) setFill(f, 0, 0);
        });
        if (wrapped) fills.forEach(function (f, k) { if (k > i) setFill(f, 0, 0); });
        // restart the active fill from 0 → 100. Force a reflow between the two
        // writes so the transition replays (rAF is unreliable when the page is
        // backgrounded, which would freeze the fill at 0).
        setFill(fills[i], 0, 0);
        if (fills[i]) void fills[i].offsetHeight;
        setFill(fills[i], 100, slide.durationMs);

        recompute();
        schedule(slide.durationMs);
      }

      function schedule(ms) {
        if (timer) clearTimeout(timer);
        if (paused) return;
        timer = setTimeout(function () { go(current + 1); }, ms || 6000);
      }

      // pause while the visitor hovers/focuses the rail so they can read it,
      // and while they hover a stance state so it stays clickable
      pauseShow = function () { paused = true; if (timer) { clearTimeout(timer); timer = null; } };
      resumeShow = function () { if (paused) { paused = false; schedule(slides[current] ? slides[current].durationMs : 6000); } };
      if (rail) {
        rail.addEventListener('mouseenter', pauseShow);
        rail.addEventListener('mouseleave', resumeShow);
        rail.addEventListener('focusin', pauseShow);
        rail.addEventListener('focusout', resumeShow);
        items.forEach(function (it, k) {
          it.addEventListener('click', function () { paused = false; go(k); });
        });
      }

      go(0);
    } else {
      stage.setAttribute('data-slide', 'members');
      focusSlide('members', true);
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

