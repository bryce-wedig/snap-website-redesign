---
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { join } from 'path';

const siteData = parse(readFileSync(join(process.cwd(), 'src/data/site.yaml'), 'utf-8'));
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="foot-inner">
    <div class="foot-brand">
      <img src={`${base}images/snap-logo.png`} alt="SNAP" />
      <p>Early-career researchers bridging science and community.</p>
      <div class="foot-socials">
        <a href={`mailto:${siteData.email}`} aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
        <a href={siteData.social.bluesky} target="_blank" rel="noopener" aria-label="Bluesky"><i class="fa-brands fa-bluesky"></i></a>
        <a href={siteData.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        <a href={siteData.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
        <a href={siteData.social.medium} target="_blank" rel="noopener" aria-label="Medium"><i class="fa-brands fa-medium"></i></a>
      </div>
    </div>
    <div class="foot-col">
      <h6>Initiatives</h6>
      <ul>
        <li><a href={`${base}initiatives/mcclintock-letters/`}>McClintock Letters</a></li>
        <li><a href={`${base}initiatives/congressional-visits/`}>Hill Day</a></li>
        <li><a href={`${base}initiatives/scipol-hackathon/`}>SciPol Hackathon</a></li>
        <li><a href={`${base}initiatives/stance-on-science/`}>Stance on Science</a></li>
        <li><a href={`${base}courses/`}>Courses</a></li>
      </ul>
    </div>
    <div class="foot-col">
      <h6>Coalition</h6>
      <ul>
        <li><a href={`${base}about/`}>About</a></li>
        <li><a href={`${base}team/`}>Team</a></li>
        <li><a href={`${base}press/`}>Press</a></li>
      </ul>
    </div>
    <div class="foot-col">
      <h6>Updates</h6>
      <ul>
        <li><a href={`${base}newsletters/`}>The Monthly</a></li>
        <li><a href={`${base}blog/`}>Blog</a></li>
        <li><a href={`mailto:${siteData.email}`}>Contact</a></li>
        <li><a href={siteData.interest_form_url} target="_blank" rel="noopener">Interest form</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {year} Scientist Network for Advancing Policy</span>
    <!-- <span></span> -->
  </div>
</footer>
