---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  date?: Date;
  author?: string;
  description?: string;
  /** Section pill shown above the title (e.g. "Blog"). The crumb trail is derived from the URL. */
  section?: string;
  /** Optional italic deck / subtitle shown beneath the H1. */
  deck?: string;
}

const { title, date, author, description, section, deck } = Astro.props;

function formatDate(d: Date | undefined): string {
  if (!d) return '';
  // Frontmatter dates parse as UTC midnight; format in UTC so the day doesn't
  // shift backwards when the site is built in a western timezone.
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}

function initials(name: string | undefined): string {
  if (!name) return 'SN';
  return name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
}
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <header class="article-head">
    <div class="container">
      <Breadcrumbs current={title} />

      {(date || author) && (
        <div class="post-meta-row">
          {section && <span class="pill">{section}</span>}
          {date && <span>{formatDate(date)}</span>}
          {author && (<><span>·</span><span>by {author}</span></>)}
        </div>
      )}

      <h1>{title}</h1>
      {deck && <p class="deck">{deck}</p>}

      {author && (
        <div class="byline">
          <div class="avatar">{initials(author)}</div>
          <div>
            <div class="who-name">{author}</div>
            <div class="who-role">SNAP coalition</div>
          </div>
        </div>
      )}
    </div>
  </header>

  <article class="article-body container-narrow">
    <div class="prose">
      <slot />
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .article-head {
    background: var(--page);
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--hairline);
  }
  .post-meta-row {
    display: flex; gap: 14px; align-items: center;
    font-family: var(--accent); font-weight: 600; font-size: 11.5px;
    color: var(--muted); letter-spacing: 0.06em;
    margin-bottom: 18px; flex-wrap: wrap;
  }
  .article-head h1 {
    font-family: var(--display); font-weight: 700;
    color: var(--navy);
    font-size: 56px; letter-spacing: -0.03em; line-height: 1.05;
    max-width: 920px;
  }
  .article-head .deck {
    font-family: var(--accent); font-weight: 500; font-style: italic;
    font-size: 22px; line-height: 1.45;
    color: var(--body); margin-top: 22px;
    max-width: 720px;
  }
  .byline {
    margin-top: 32px;
    display: flex; gap: 16px; align-items: center;
    padding-top: 22px; border-top: 1px solid var(--hairline);
  }
  .byline .avatar {
    width: 56px; height: 56px; border-radius: 50%;
    background: linear-gradient(155deg, var(--peach), var(--orange));
    color: white; display: flex; align-items: center; justify-content: center;
    font-family: var(--display); font-weight: 700; font-size: 20px;
    flex-shrink: 0;
  }
  .byline .who-name {
    font-family: var(--display); font-weight: 700; font-size: 16px;
    color: var(--navy); letter-spacing: -0.005em;
  }
  .byline .who-role {
    font-family: var(--accent); font-weight: 500; font-size: 12px;
    color: var(--muted); margin-top: 2px; letter-spacing: 0.04em;
  }

  .article-body {
    margin: 64px auto;
    font-size: 19px; line-height: 1.75; color: var(--body);
  }
  .article-body .prose > p:first-of-type::first-letter {
    font-family: var(--display); font-weight: 700;
    float: left; font-size: 84px; line-height: 0.85;
    color: var(--orange); padding: 6px 14px 0 0;
  }
  .article-body :global(h2) {
    font-family: var(--display); font-weight: 700; font-size: 34px;
    color: var(--navy); letter-spacing: -0.02em; line-height: 1.15;
    margin: 56px 0 16px;
  }
  .article-body :global(h3) {
    font-family: var(--display); font-weight: 700; font-size: 22px;
    color: var(--navy); letter-spacing: -0.01em;
    margin: 36px 0 12px;
  }
  .article-body :global(blockquote) {
    margin: 36px 0;
    padding-left: 24px;
    border-left: 3px solid var(--orange);
    border-radius: 0;
    background: transparent;
    font-family: var(--accent); font-weight: 500; font-style: italic;
    font-size: 24px; line-height: 1.4; color: var(--navy);
  }
  .article-body :global(a) {
    color: var(--orange); text-decoration: underline; text-underline-offset: 3px;
  }
  .article-body :global(a:hover) { color: var(--navy); }
  /* Button-styled links (e.g. "Apply Now!") keep their button colors. */
  .article-body :global(a.btn) { text-decoration: none; }
  .article-body :global(a.btn-primary),
  .article-body :global(a.btn-primary:hover) { color: white; }
  .article-body :global(strong) { color: var(--navy); font-weight: 700; }
  .article-body :global(em) { font-style: italic; }
  .article-body :global(img) {
    border-radius: var(--r-lg);
    margin: 2rem auto;
    border: 1px solid var(--hairline);
  }

  @media (max-width: 720px) {
    .article-head h1 { font-size: 36px; }
    .article-body { font-size: 17px; }
  }
</style>
